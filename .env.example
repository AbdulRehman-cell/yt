# ---- Server ----
# Port the standalone Express server listens on (ignored on Vercel; auto-assigned)
PORT=5000

# Node environment: development | production
NODE_ENV=development

# MongoDB connection string (Atlas recommended for Vercel/serverless)
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/yt?retryWrites=true&w=majority
MONGO_URI=

# Allowed CORS origin for the client (set to your deployed frontend URL in production)
CLIENT_ORIGIN=http://localhost:5173

# ---- Client (Vite/CRA convention — adjust prefix to match your client tooling) ----
# Base URL the client uses to call the API
VITE_API_URL=/api