# ---------------------------------------------
# Server Configuration
# ---------------------------------------------

# Port the Express server listens on (Render sets this automatically; use 10000 locally)
PORT=10000

# Environment mode: development | production
NODE_ENV=development

# ---------------------------------------------
# Database
# ---------------------------------------------

# MongoDB connection string.
# Local (docker-compose): mongodb://root:changeme_local_only@localhost:27017/yt?authSource=admin
# Production (MongoDB Atlas): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGO_URI=mongodb://root:changeme_local_only@localhost:27017/yt?authSource=admin

# ---------------------------------------------
# CORS / Client
# ---------------------------------------------

# Origin allowed to call the API (your deployed client URL)
CLIENT_ORIGIN=http://localhost:3000

# ---------------------------------------------
# Docker Compose only (local Mongo container)
# ---------------------------------------------

MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=changeme_local_only
MONGO_DB_NAME=yt