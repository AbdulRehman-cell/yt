# ---------------------------------------------
# Server Configuration
# ---------------------------------------------
# Port the Express server listens on (Render injects PORT automatically in prod)
PORT=10000

# Environment: development | production
NODE_ENV=development

# ---------------------------------------------
# Database (MongoDB)
# ---------------------------------------------
# Full MongoDB connection string.
# Local docker-compose example:
#   mongodb://root:changeme@localhost:27017/yt?authSource=admin
# MongoDB Atlas example:
#   mongodb+srv://<user>:<password>@cluster0.mongodb.net/yt?retryWrites=true&w=majority
MONGO_URI=mongodb://root:changeme@localhost:27017/yt?authSource=admin

# Only needed for docker-compose local Mongo container
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=changeme
MONGO_DB_NAME=yt

# ---------------------------------------------
# Security
# ---------------------------------------------
# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:5173

# Secret used for signing JWTs / sessions (generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_a_long_random_secret

# ---------------------------------------------
# Client build-time vars (if client reads env at build)
# ---------------------------------------------
# VITE_API_BASE_URL=https://your-app.onrender.com/api