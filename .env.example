# ---------------------------------------------------
# Environment variables required by the application
# Copy this file to ".env" and fill in real values.
# NEVER commit your actual .env file.
# ---------------------------------------------------

# Runtime environment: development | production
NODE_ENV=production

# Port the Express server listens on
# Render sets this automatically in production; default matches Dockerfile
PORT=10000

# MongoDB connection string
# Local docker-compose:  mongodb://mongo:27017/yt
# MongoDB Atlas example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/yt?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/yt

# Allowed CORS origin for the client (set to your Render/Vercel client URL)
CLIENT_ORIGIN=http://localhost:5173

# Secret used for signing sessions/tokens (generate a long random string)
SESSION_SECRET=change-me-to-a-long-random-string