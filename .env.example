# ---- Server ----
# Port the Express server listens on (Render injects its own PORT automatically)
PORT=10000

# Runtime environment: development | production
NODE_ENV=development

# ---- Database ----
# MongoDB connection string (local docker-compose, Render managed DB, or Atlas)
MONGO_URI=mongodb://localhost:27017/yt

# ---- Security ----
# Secret used to sign auth tokens (JWT). Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated list of allowed CORS origins for the client
CLIENT_ORIGIN=http://localhost:5173

# ---- Client build (Vite) ----
# Base URL the client uses to reach the API (set at build time)
VITE_API_BASE_URL=http://localhost:10000/api

# ---- Optional third-party keys (uncomment/add as needed) ----
# YOUTUBE_API_KEY=
# REDIS_URL=