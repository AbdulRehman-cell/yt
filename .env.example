# ---- Server ----
# Port the Express server listens on locally / in Docker (Vercel ignores this)
PORT=5000

# Node environment: development | production
NODE_ENV=production

# ---- Database ----
# MongoDB connection string.
# Local/Docker:  mongodb://mongo:27017/yt
# Production:    MongoDB Atlas SRV URI (required on Vercel — no local DB available)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/yt?retryWrites=true&w=majority

# ---- CORS ----
# Allowed origin for the client app. Use your deployed domain in production.
CORS_ORIGIN=https://your-app.vercel.app

# ---- Vercel deploy (used only in GitHub Actions secrets, not runtime) ----
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=