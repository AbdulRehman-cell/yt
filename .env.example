# ---------------------------------------------------------
# Server runtime
# ---------------------------------------------------------
NODE_ENV=production
# Port the Express server listens on (Render sets $PORT automatically in prod,
# but keep a default for local/docker use)
PORT=3000

# ---------------------------------------------------------
# Database
# ---------------------------------------------------------
# MongoDB connection string.
# Local docker-compose default: mongodb://mongo:27017/yt
# Production: use MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@cluster0.mongodb.net/yt?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/yt

# ---------------------------------------------------------
# CORS
# ---------------------------------------------------------
# Comma-separated list of allowed origins for the API.
# In production set this to your deployed client URL(s).
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------
# Optional: Redis (only needed if caching/sessions/queues are added)
# ---------------------------------------------------------
# REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------
# Optional: Third-party API keys (add as your app requires them)
# ---------------------------------------------------------
# YOUTUBE_API_KEY=your_key_here